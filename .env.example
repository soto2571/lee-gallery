# Copia esto a .env.local (dev) y ponlo en Vercel → Settings → Environment Variables (producción).

# Login del panel /admin. Si no los pones, se usan los valores por defecto
# que están en lib/auth.ts (ShayAdmin / Password!234) — cámbialos en producción.
ADMIN_USER=ShayAdmin
ADMIN_PASSWORD=Password!234

# Cualquier texto largo y aleatorio: con esto se firma la cookie de sesión.
ADMIN_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# BLOB_READ_WRITE_TOKEN lo inyecta Vercel solo, al conectar un Blob Store al
# proyecto. No hay que escribirlo a mano. Sin él, el panel guarda en disco local.
